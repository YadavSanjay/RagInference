# Copy to infra/.env and adjust. Consumed by docker-compose.yml (Case B).

# --- Deployment mode --------------------------------------------------------
# local (default) | aws. In aws mode the service derives: host=0.0.0.0,
# JSON logs to stdout (CloudWatch), no rotating log file, and the artifact
# storage backend defaults to s3. Any explicit var below still overrides.
DEPLOY_MODE=local

# --- Model delivery ---------------------------------------------------------
# baked | hf | s3   (per-container; compose sets this per service)
MODEL_SOURCE=baked

# S3 location of the HF-cache-layout weights (Case B, MODEL_SOURCE=s3).
MODEL_S3_URI=s3://raginfer-models

# For real AWS S3: leave AWS_ENDPOINT_URL unset and use IAM creds/role.
# For local MinIO demo: point at the in-compose MinIO.
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# --- Service config (passed through to the app) -----------------------------
RERANKER=jina
EMBEDDER=bge
RAGINFER_PORT=8799

# --- AWS mode extras (only read when DEPLOY_MODE=aws) ------------------------
# Structured logging + storage seam. Uncomment/set in the AWS task definition.
# RAGINFER_LOG_FORMAT=json          # aws default; text|json
# RAGINFER_LOG_TO_FILE=false        # aws default; stdout only for CloudWatch
# RAGINFER_ARTIFACT_BACKEND=s3      # aws default; local|s3 (future blob IO)
# RAGINFER_ARTIFACT_BUCKET=raginfer-artifacts
# RAGINFER_ARTIFACT_PREFIX=raginfer
# AWS_REGION=us-east-1              # weights + storage region (or use task role's)

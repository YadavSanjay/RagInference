# Copy to infra/.env and adjust. Consumed by docker-compose.yml (Case B).

# --- Model delivery ---------------------------------------------------------
# baked | hf | s3   (per-container; compose sets this per service)
MODEL_SOURCE=baked

# S3 location of the HF-cache-layout weights (Case B, MODEL_SOURCE=s3).
MODEL_S3_URI=s3://raginfer-models

# For real AWS S3: leave AWS_ENDPOINT_URL unset and use IAM creds/role.
# For local MinIO demo: point at the in-compose MinIO.
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# --- Service config (passed through to the app) -----------------------------
RERANKER=jina
EMBEDDER=bge
RAGINFER_PORT=8799

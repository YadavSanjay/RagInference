# Deploy vars for the ECR build/push runbook (docs/runbook/build-and-push-ecr.md).
#
# Copy this file to  infra/aws/deploy.env  (which is .gitignored) and fill in the
# real values. The real deploy.env is NEVER committed — it holds the account id.
#
#   cp infra/aws/deploy.env.example infra/aws/deploy.env   # then edit

# 12-digit AWS account id
ACCT=<acct>
# Region the ECR repo lives in
REGION=us-east-1
# ECR repo path (namespace/repo) under the registry
ECR_NAMESPACE=<ecr-repo>
# AWS CLI profile whose role has ecr:* (used for docker login + push)
AWS_PROFILE=<aws-profile>

{
  "family": "raginfer",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "4096",
  "memory": "16384",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<raginfer-execution-role>",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<raginfer-task-role>",
  "containerDefinitions": [
    {
      "name": "raginfer",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/raginfer:slim-arm64",
      "essential": true,
      "portMappings": [
        { "containerPort": 8799, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DEPLOY_MODE", "value": "aws" },
        { "name": "MODEL_SOURCE", "value": "s3" },
        { "name": "MODEL_S3_URI", "value": "s3://<WEIGHTS_BUCKET>" },
        { "name": "HF_HOME", "value": "/models" },
        { "name": "RERANKER", "value": "jina" },
        { "name": "EMBEDDER", "value": "bge" },
        { "name": "AWS_REGION", "value": "<REGION>" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/readyz'%os.getenv('RAGINFER_PORT','8799'),timeout=4).status==200 else 1)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 300
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/raginfer",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "raginfer"
        }
      },
      "stopTimeout": 30
    }
  ]
}
